execute if score $pista dedsafio_vars matches 4 run tellraw @a {text:"Iceberg: el rayo no busca al más lento. Busca al que se quedó mirando.",color:"aqua"}
execute if score $pista dedsafio_vars matches 5 run tellraw @a {text:"Iceberg: el T-Rex no guarda rencor. Guarda la lista.",color:"aqua"}
